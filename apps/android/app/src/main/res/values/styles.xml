<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typographic system: condensed grotesque for names, monospace for machine facts. -->
    <style name="Dsh" />

    <style name="Dsh.Wordmark">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dsh.Title">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dsh.SectionLabel">
        <item name="android:fontFamily">@string/font_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dsh.Mono">
        <item name="android:fontFamily">@string/font_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dsh.Mono.Strong">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Dsh.ItemName">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dsh.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Dsh.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Dsh.Button.Ghost" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Dsh.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_mono</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Dsh.Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">@string/font_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
